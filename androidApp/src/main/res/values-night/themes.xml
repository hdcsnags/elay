<?xml version="1.0" encoding="utf-8"?>
<!-- Stage 6 LEAD-0: dark cold start paints §B's Obsidian Truffle canvas, never white. -->
<resources>
    <style name="Theme.Elay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/elay_ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Elay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/elay_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Elay</item>
    </style>
</resources>
